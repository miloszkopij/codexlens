# Workspace-scoped ChatGPT Admin key. Never commit the real value.
CHATGPT_ADMIN_KEY=

# The ChatGPT workspace this key belongs to.
CHATGPT_WORKSPACE_ID=your_workspace_id
CHATGPT_WORKSPACE_NAME=your_workspace_name

# Daily per-user Codex history loaded by each sync (1-3650 days).
CODEX_ANALYTICS_HISTORY_DAYS=365

# API defaults. Override only if your environment uses a different gateway.
CHATGPT_ADMIN_BASE_URL=https://api.chatgpt.com/v1
PEOPLE_API_BASE_URL=https://people.allegrogroup.com
MANAGEMENT_LEADER_NAME=David Roberts
